#!/bin/sh
set -eu
bin=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
install_dir=$(dirname "$bin")
app="$install_dir/releases/$(cat "$install_dir/current")"
: "${JAGENT_STATE_DIR:=$HOME/.jagent}"
export JAGENT_STATE_DIR
case "${1:-}" in
  --help|-h|help)
    echo 'jagent                Start the local Harness, Console and Runner, or reopen the Console
jagent server         Start the Harness and Console
jagent runner         Start the Coding Runner (see jagent runner --help)
jagent open [--link]  Open the Console or print a single-use link
jagent pair CODE      Approve a browser from its Runner machine'
    ;;
  runner|open|pair) exec java -jar "$app/runner/runner.jar" "$@" ;;
  ''|server)
    if [ ! -f "$app/distribution.json" ]; then echo 'Install the full application for this command. Use jagent runner with the Runner package.' >&2; exit 1; fi
    exec node "$app/scripts/global.mjs" "$@" ;;
  *) echo 'Unknown command. Run jagent --help.' >&2; exit 2 ;;
esac
