<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.differentialmanifold</groupId>
    <artifactId>jagent-harness</artifactId>
    <version>2.2.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>jagent-coding-runner</artifactId>
  <name>Coding runner with local tools</name>
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.differentialmanifold</groupId>
      <artifactId>jagent-client-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.8.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.differentialmanifold.jagentharness.runner.RunnerMain</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>offline-runner-package</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/runners/coding" />
                <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.build.directory}/runners/coding/runner.jar" overwrite="true" />
                <checksum file="${project.build.directory}/runners/coding/runner.jar" algorithm="SHA-256" property="runner.sha256" />
                <echo file="${project.build.directory}/runners/coding/manifest.json" encoding="UTF-8">{"kind":"coding","version":"${project.version}","artifact":"runner.jar","sha256":"${runner.sha256}","javaVersion":8}</echo>
                <zip destfile="${project.build.directory}/jagent-coding-runner-${project.version}-offline.zip" basedir="${project.build.directory}/runners" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
