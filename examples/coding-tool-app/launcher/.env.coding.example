# Copy this file to .env.coding.local and edit the local copy.
# Existing operating-system environment variables take precedence.

# Model provider
JAGENT_OPENAI_API_KEY=
# Example for a local OpenAI-compatible endpoint: http://127.0.0.1:10200/v1
JAGENT_OPENAI_BASE_URL=
# Use the model ID accepted by the endpoint. It may also be a local model path.
JAGENT_MODEL=
JAGENT_MODEL_STREAM_ENABLED=true
# Set to false if the endpoint rejects stream_options.include_usage.
JAGENT_MODEL_INCLUDE_USAGE=true
JAGENT_CONTEXT_WINDOW_TOKENS=128000
# Encoded JSON request cap; keep this above the 20 MB decoded-image limit.
JAGENT_MAX_CHAT_REQUEST_BODY_SIZE=32MB

# Local services
SERVER_PORT=18080
JAGENT_OPEN_BROWSER=true

# Persistence
JAGENT_DATASOURCE_URL=jdbc:sqlite:jagent-harness.db
JAGENT_DATASOURCE_DRIVER=org.sqlite.JDBC

# Optional overrides
# JAGENT_TEMPERATURE=0.7
# JAGENT_CONFIG_ROOT=/absolute/path/to/.jagent-harness
# JAGENT_RG_PATH=/absolute/path/to/rg
