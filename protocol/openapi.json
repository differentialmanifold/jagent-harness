{
  "openapi": "3.1.0",
  "info": {
    "title": "JAgent conversation API",
    "version": "2.2.1",
    "description": "Conversation and Runner SDK contract. Personal Agent delegation is documented separately in skills/jagent/references/api.md."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18181/api/v1"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/chat": {
      "post": {
        "operationId": "chat",
        "summary": "Send a message to a project; the server selects its configured execution target",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/ChatSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conversation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/ChatResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: response\ndata: {\"sessionId\":\"sess_example\",\"runId\":\"run_example\",\"status\":\"COMPLETED\",\"toolCalls\":[]}\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid user message or unsupported submission fields, including tool results and client tool metadata"
          },
          "401": {
            "description": "Invalid bearer token"
          },
          "409": {
            "description": "Another request is modifying this session"
          },
          "413": {
            "description": "Request too large"
          },
          "503": {
            "description": "Capacity exhausted"
          }
        },
        "description": "Public user message submission. Accepts exactly one user message, sessionId, optional runId and stream. The server selects execution from project configuration. Runner-bound projects dispatch to their assigned Runner; server-only projects execute on the server. Tool results, clientTools and clientInstructions are rejected here. JSON waits for the terminal result; SSE streams progress. No automatic replay or idempotency is provided.",
        "tags": [
          "Public conversation API"
        ]
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "workspacePath": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Workspace on the runner for a new file-based project; never resolved on the server."
                  },
                  "projectName": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "runnerId": {
                    "type": "string",
                    "description": "Optional terminal for a new project. Existing projects inherit their saved execution settings."
                  },
                  "projectId": {
                    "type": "string",
                    "description": "Reuse an existing project and its workspace and tools."
                  },
                  "enabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Tools selected for a new runner project; omitted means all registered tools, [] means none."
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session record including sessionId"
          }
        }
      },
      "get": {
        "operationId": "listSessions",
        "responses": {
          "200": {
            "description": "Session records"
          }
        }
      }
    },
    "/sessions/{sessionId}/state": {
      "parameters": [
        {
          "in": "path",
          "name": "sessionId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "get": {
        "operationId": "getSessionState",
        "responses": {
          "200": {
            "description": "Current run state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/ChatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Session has no run"
          }
        }
      }
    },
    "/runs/{runId}/stop": {
      "parameters": [
        {
          "in": "path",
          "name": "runId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "stopRun",
        "responses": {
          "200": {
            "description": "Cancellation requested"
          }
        }
      }
    },
    "/runs/{runId}/inputs": {
      "parameters": [
        {
          "in": "path",
          "name": "runId",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        }
      ],
      "post": {
        "operationId": "queueRunInput",
        "description": "Additional user input consumed at the next model boundary; never a tool-result continuation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "inputId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "content": {
                    "type": "string"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "$ref": "schema.json#/definitions/Image"
                    }
                  }
                },
                "required": [
                  "inputId",
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Input receipt. REJECTED means the run is missing or no longer accepts input; the message was not queued. Retries of stored inputs return their current status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "inputId",
                    "status"
                  ],
                  "properties": {
                    "inputId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "ACCEPTED",
                        "CLAIMED",
                        "CANCELLED",
                        "REJECTED"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/runners": {
      "get": {
        "operationId": "listRunners",
        "summary": "List registered terminals",
        "responses": {
          "200": {
            "description": "Runner catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "schema.json#/definitions/RunnerInfo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "registerRunner",
        "summary": "Register or update this runner",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerInfo"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing server token"
          },
          "403": {
            "description": "Invalid runner credentials"
          },
          "409": {
            "description": "Conflicting operation or offline runner"
          }
        },
        "parameters": [
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/RunnerInfo"
              }
            }
          }
        }
      }
    },
    "/runners/{id}/poll": {
      "get": {
        "operationId": "pollRunner",
        "summary": "Wait up to 25 seconds for an assigned conversation, cancellation or directory lookup",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerPoll"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing server token"
          },
          "403": {
            "description": "Invalid runner credentials"
          },
          "409": {
            "description": "Conflicting operation or offline runner"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "activeRun",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/runners/chat": {
      "post": {
        "operationId": "advanceRunnerConversation",
        "summary": "Internal Runner protocol: advance a claimed conversation with user input or tool results",
        "responses": {
          "200": {
            "description": "Conversation response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/ChatResponse"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: response\ndata: {\"sessionId\":\"sess_example\",\"runId\":\"run_example\",\"status\":\"COMPLETED\",\"toolCalls\":[]}\n\n"
              }
            }
          },
          "400": {
            "description": "Invalid message, tool catalog or history association"
          },
          "401": {
            "description": "Invalid bearer token"
          },
          "403": {
            "description": "Missing or invalid Runner credentials, or session not assigned to a Runner"
          },
          "409": {
            "description": "Runner does not own a claimed job for this session, or the session is busy"
          },
          "413": {
            "description": "Request too large"
          },
          "503": {
            "description": "Capacity exhausted"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/ChatRequest"
              }
            }
          }
        },
        "description": "Called only by a registered Runner with a claimed job. Requires X-Runner-Id and X-Runner-Secret in addition to the server token. The server verifies the session/job assignment and uses the frozen tool catalog. This endpoint never queues another job; REQUIRES_ACTION returns tools to that Runner. Not a public UI or external Agent entry point.",
        "parameters": [
          {
            "name": "X-Runner-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "tags": [
          "Internal Runner protocol"
        ],
        "x-internal": true
      }
    },
    "/runners/{id}/complete": {
      "post": {
        "operationId": "completeRunnerJob",
        "summary": "Report a terminal conversation outcome",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing server token"
          },
          "403": {
            "description": "Invalid runner credentials"
          },
          "409": {
            "description": "Conflicting operation or offline runner"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/ChatResponse"
              }
            }
          }
        }
      }
    },
    "/runners/{id}/events": {
      "post": {
        "operationId": "reportRunnerEvent",
        "summary": "Report a local tool execution start or end",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing server token"
          },
          "403": {
            "description": "Invalid runner credentials"
          },
          "409": {
            "description": "Conflicting operation or offline runner"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/StreamEvent"
              }
            }
          }
        }
      }
    },
    "/runners/runs/{run}": {
      "get": {
        "operationId": "inspectRunnerJob",
        "summary": "Inspect durable dispatch status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerJob"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Missing server token"
          },
          "403": {
            "description": "Invalid runner credentials"
          },
          "409": {
            "description": "Conflicting operation or offline runner"
          }
        },
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/runners/runs/{run}/events": {
      "get": {
        "operationId": "watchRunnerJob",
        "summary": "Subscribe to future events; use session details for saved history",
        "responses": {
          "200": {
            "description": "Future events and the final response",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/runners/{id}/runs/{run}/recover": {
      "post": {
        "operationId": "recoverRunnerDispatch",
        "summary": "Explicitly recover an interrupted dispatch with pending tool results; does not execute the harness",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Claimed dispatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerJob"
                }
              }
            }
          },
          "409": {
            "description": "No pending results or another active dispatch"
          }
        }
      }
    },
    "/runners/projects/{projectId}": {
      "get": {
        "operationId": "getRunnerProject",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerProject"
                }
              }
            }
          }
        }
      }
    },
    "/runners/projects/{projectId}/tools": {
      "put": {
        "operationId": "selectProjectTools",
        "summary": "Save the enabled client tools for subsequent project runs",
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabledTools": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "enabledTools"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/RunnerProject"
                }
              }
            }
          }
        }
      }
    },
    "/runners/{id}/workspaces": {
      "get": {
        "operationId": "browseRunnerWorkspace",
        "summary": "Browse a terminal directory through outbound runner polling",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/WorkspaceListing"
                }
              }
            }
          },
          "400": {
            "description": "Invalid directory or workspace-free runner"
          },
          "409": {
            "description": "Runner offline or lookup in progress"
          },
          "504": {
            "description": "Runner did not respond within 10 seconds"
          }
        }
      }
    },
    "/runners/{id}/workspaces/result": {
      "post": {
        "operationId": "reportRunnerWorkspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Runner-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/WorkspaceListing"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lookup result accepted"
          }
        }
      }
    },
    "/models": {
      "get": {
        "summary": "Read configured models and their capabilities; API keys are masked",
        "responses": {
          "200": {
            "description": "Model catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "schema.json#/definitions/ModelConfiguration"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save model settings with the current revision; blank keys retain saved credentials",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "schema.json#/definitions/ModelConfiguration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved, masked catalog"
          },
          "400": {
            "description": "Invalid configuration or revision conflict"
          }
        }
      }
    },
    "/models/{id}/test": {
      "post": {
        "summary": "Check a saved model connection without verifying its declared capabilities",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Connection response"
          }
        }
      }
    }
  }
}
